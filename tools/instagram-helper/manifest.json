{
 "manifest_version":3,
 "name":"Fields IA · Instagram conectado",
 "version":"1.1.0",
 "description":"Configure uma vez e importe pelo botão Baixar do Fields IA. Desconecte quando quiser.",
 "permissions":["alarms","storage"],
 "content_scripts":[{"matches":["https://fieldsia.r2rmarketingdigital.com.br/*"],"js":["bridge.js"],"run_at":"document_start","all_frames":false}],
 "background":{"service_worker":"cleanup.js"},
 "optional_permissions":["cookies","scripting"],
 "optional_host_permissions":["https://www.instagram.com/*","https://fieldsia.r2rmarketingdigital.com.br/*"],
 "action":{"default_popup":"popup.html","default_title":"Conexão Instagram do Fields IA"}
}

