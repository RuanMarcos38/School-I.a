      "parameters": {
        "jsCode": "const b=$('Validar e deduplicar').first().json;const s=$getWorkflowStaticData('global');s.sent=s.sent||{};s.sent[b.eventId]=Date.now();for(const [id,t]of Object.entries(s.sent))if(Date.now()-t>90*86400000)delete s.sent[id];return [{json:{id:b.eventId,accepted:true}}];"
      }
