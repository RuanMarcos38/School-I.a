      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body;if(!b||typeof b.eventId!=='string'||b.eventId.length>200||typeof b.to!=='string'||!/^[^\\s@,;]+@[^\\s@,;]+\\.[^\\s@,;]+$/.test(b.to)||typeof b.subject!=='string'||/[\\r\\n]/.test(b.subject)||b.subject.length>200||typeof b.html!=='string'||b.html.length>100000||typeof b.text!=='string')throw new Error('Evento inválido');const s=$getWorkflowStaticData('global');s.sent=s.sent||{};return [{json:{...b,duplicate:!!s.sent[b.eventId]}}];"
      }
    },
